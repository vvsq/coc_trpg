# LLM 供应商配置模板（复制本文件为 .env；密钥仅存本地，不入 git）
#
# ┌─ 首次配置怎么选（goal §7 6.1：没配 key 也能进演示）──────────────────────┐
# │ 方式一：什么都不填 —— start.bat 会自建 .env，进大厅后点引导条的          │
# │         「启用演示模式」，AI 用本地固定内容主持，不发真实请求。           │
# │ 方式二：填下面的 LLM_API_KEY + LLM_MODEL（任选一家供应商）。              │
# │ 方式三：先进游戏，在大厅「API / 模型配置」里在线填（推荐，可现场探测模型）│
# └──────────────────────────────────────────────────────────────────────────┘
#
# ⚠ 配置权威在哪：4.4 起 **llm_config 表（数据库）是唯一权威**，本文件只在
#   「数据库里还没有配置行」时被读入做一次种子。之后再改这里不生效，
#   请在游戏内「API / 模型配置」里改（改动会热重载，无需重启）。
#
# 供应商预设（抄 base_url 与 model 即可；模型名迭代快，静态表只作推荐，
# 真实可用列表以设置面板的「探测模型」为准，也支持手填）：
#   智谱 GLM        https://open.bigmodel.cn/api/paas/v4                     glm-5.3-flash / glm-5.3
#   DeepSeek        https://api.deepseek.com/v1                              deepseek-v4-pro / deepseek-v4-flash
#   阿里云百炼千问  https://dashscope.aliyuncs.com/compatible-mode/v1        qwen-flash / qwen-plus / qwen-max
#   OpenAI          https://api.openai.com/v1                                gpt-5-mini / gpt-5.2
#   其他 OpenAI 兼容中转：直接填其中转地址（会被识别为 custom）

LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen-flash

# ── 演示 / 断网兜底（可选）────────────────────────────────────────────────
# 把 model 改成 mock 即启用 MockLLMClient：不发真实网络请求，AI 返回固定演示内容，
# 无 key 也能跑通建卡 → 开团 → 检定 → 协同建议 → 全自动主持的全流程。
# LLM_MODEL=mock

# ── 运行时参数（可选；也可在设置面板里改，DB 生效）────────────────────────
# 请求超时秒数（默认 30）：混合推理模型（qwen3 系）首次响应慢，实测调 300~600 更稳
# LLM_TIMEOUT=30
# 失败重试次数（默认 2）
# LLM_RETRIES=2
# 关闭混合推理模型的思考模式（默认关）：qwen3 系非流式默认会思考，容易超时
# LLM_DISABLE_THINKING=1

# ── 轻任务模型（建议生成 / 场景摘要 / 解析修复）────────────────────────────
# 注意：light_* 三项**只能**在游戏内「API / 模型配置」里填（本文件不支持），
# 留空 = 轻任务跟随主模型。填一个便宜快的模型（如 qwen3.8-flash）可显著省 token。
